@page "/"
@inject IJSRuntime JS

<PageTitle>Reginald Alfret V | Open-Source Contributor · AI &amp; DS Engineer (Blazor)</PageTitle>

<main class="w-full min-h-screen bg-[#050505] text-neutral-100 py-6 px-3 sm:px-6 md:px-8 selection:bg-purple-500/25 selection:text-purple-200">
  <!-- Sticky Top Control Bar -->
  <div class="max-w-6xl mx-auto mb-6 sticky top-3 z-50">
    <div class="backdrop-blur-xl bg-black/70 border border-white/10 rounded-2xl p-2.5 sm:p-3 shadow-2xl flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-2.5 px-2">
        <div class="w-8 h-8 rounded-xl bg-gradient-to-tr from-purple-700 via-indigo-600 to-purple-500 flex items-center justify-center shadow-lg shadow-purple-500/20 text-white font-black text-sm">
          B
        </div>
        <div>
          <div class="text-sm font-semibold tracking-wide text-white">Reginald Alfret V</div>
          <div class="text-[11px] text-purple-400 font-mono tracking-wider">RESUME PORTFOLIO (BLAZOR WASM)</div>
        </div>
      </div>

      <!-- View Switcher -->
      <div class="flex items-center bg-white/5 border border-white/10 rounded-xl p-1 text-xs">
        <button
          type="button"
          @onclick="@(() => viewMode = "interactive")"
          class="@(viewMode == "interactive" ? "flex items-center gap-1.5 px-3 py-1.5 rounded-lg font-medium transition-all bg-purple-500/20 text-purple-300 border border-purple-500/30 shadow-sm" : "flex items-center gap-1.5 px-3 py-1.5 rounded-lg font-medium transition-all text-neutral-400 hover:text-white")"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          <span>Interactive Resume</span>
        </button>
        <button
          type="button"
          @onclick="@(() => viewMode = "pdf")"
          class="@(viewMode == "pdf" ? "flex items-center gap-1.5 px-3 py-1.5 rounded-lg font-medium transition-all bg-purple-500/20 text-purple-300 border border-purple-500/30 shadow-sm" : "flex items-center gap-1.5 px-3 py-1.5 rounded-lg font-medium transition-all text-neutral-400 hover:text-white")"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
          <span>Original PDF Document</span>
        </button>
      </div>

      <!-- Action Buttons -->
      <div class="flex items-center gap-2">
        <button
          type="button"
          @onclick="PrintResume"
          class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-medium bg-white/5 hover:bg-white/10 border border-white/10 text-neutral-300 hover:text-white transition-colors"
          title="Print Resume"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
          <span>Print</span>
        </button>

        <a
          href="/Reginald_Alfret_Resume.pdf"
          download="Reginald_Alfret_Resume.pdf"
          class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-purple-600 hover:bg-purple-500 text-white shadow-lg shadow-purple-500/25 transition-all"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          <span>Download PDF</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Main Container -->
  <div class="max-w-6xl mx-auto">
    @if (viewMode == "pdf")
    {
      <!-- PDF View Mode -->
      <div class="backdrop-blur-2xl bg-neutral-950/80 border border-white/10 rounded-3xl p-4 sm:p-6 shadow-2xl">
        <div class="flex items-center justify-between mb-4 pb-3 border-b border-white/10">
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-purple-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
            <h2 class="text-base font-semibold text-white">Reginald_Alfret_Resume.pdf</h2>
            <span class="text-xs font-mono text-neutral-400 px-2 py-0.5 rounded bg-white/5 border border-white/5">
              1 Page Visual Resume
            </span>
          </div>
          <a
            href="/Reginald_Alfret_Resume.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs font-medium text-purple-400 hover:text-purple-300 transition-colors inline-flex items-center gap-1"
          >
            <span>Open in New Tab</span>
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          </a>
        </div>
        <div class="w-full h-[85vh] rounded-2xl overflow-hidden border border-white/10 bg-[#0a0a0a]">
          <object
            data="/Reginald_Alfret_Resume.pdf"
            type="application/pdf"
            class="w-full h-full"
          >
            <div class="h-full flex flex-col items-center justify-center p-6 text-center text-neutral-400">
              <p class="mb-4">PDF cannot be directly embedded in this browser.</p>
              <a
                href="/Reginald_Alfret_Resume.pdf"
                download
                class="px-4 py-2 bg-purple-600 text-white rounded-xl text-sm font-semibold hover:bg-purple-500 transition-colors"
              >
                Download Resume PDF
              </a>
            </div>
          </object>
        </div>
      </div>
    }
    else
    {
      <!-- Interactive Resume View -->
      <div class="space-y-6">
        <!-- 1. Header Hero Card -->
        <section class="backdrop-blur-2xl bg-neutral-950/70 border border-white/10 rounded-3xl p-6 sm:p-8 shadow-2xl relative overflow-hidden">
          <div class="absolute -top-24 -right-24 w-80 h-80 rounded-full bg-purple-500/10 blur-3xl pointer-events-none"></div>

          <div class="flex flex-col md:flex-row md:items-start justify-between gap-6 relative z-10">
            <div class="space-y-3">
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-500/10 border border-purple-500/25 text-purple-300 text-xs font-mono">
                <span class="w-2 h-2 rounded-full bg-purple-400 animate-pulse"></span>
                <span>BLAZOR .NET 8 WASM · 30 MERGED PRS · AI &amp; DS ENGINEER</span>
              </div>
              <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-white">
                Reginald Alfret V
              </h1>
              <p class="text-base sm:text-lg text-neutral-300 max-w-2xl font-light leading-relaxed">
                Open-Source Contributor &amp; Software Developer specializing in AI, Data Science &amp; Full-Stack Systems.
                Proven track record with 30 merged PRs across tier-1 organizations including Google, Apple, Microsoft, Meta, AWS, NVIDIA, NASA &amp; Netflix.
              </p>

              <!-- Quick Info Badges -->
              <div class="flex flex-wrap items-center gap-2.5 pt-2 text-xs text-neutral-300">
                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white/5 border border-white/10">
                  <svg class="w-3.5 h-3.5 text-purple-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                  <span>Chennai, Tamil Nadu, India</span>
                </span>
                <a href="https://github.com/reginaldalfret" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-neutral-300 hover:text-white transition-colors">
                  <svg class="w-3.5 h-3.5 text-neutral-400" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
                  <span>github.com/reginaldalfret</span>
                </a>
                <a href="https://linkedin.com/in/reginald-alfret" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-neutral-300 hover:text-white transition-colors">
                  <svg class="w-3.5 h-3.5 text-blue-400" viewBox="0 0 24 24" fill="currentColor"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                  <span>LinkedIn</span>
                </a>
                <a href="mailto:reginaldalfret@gmail.com" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-neutral-300 hover:text-white transition-colors">
                  <svg class="w-3.5 h-3.5 text-red-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                  <span>reginaldalfret@gmail.com</span>
                </a>
                <a href="tel:+919940562661" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-neutral-300 hover:text-white transition-colors">
                  <svg class="w-3.5 h-3.5 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                  <span>+91 99405 62661</span>
                </a>
              </div>
            </div>

            <!-- Stats Badge Card -->
            <div class="backdrop-blur-xl bg-black/40 border border-white/10 rounded-2xl p-4 flex flex-col items-center justify-center min-w-[200px] text-center space-y-1 shadow-inner">
              <div class="text-3xl font-black text-transparent bg-clip-text bg-gradient-to-r from-purple-400 via-indigo-300 to-pink-300">
                30 / 30
              </div>
              <div class="text-xs font-semibold uppercase tracking-wider text-neutral-300">Merged PRs</div>
              <div class="text-[11px] text-neutral-500 font-mono">100% Success Rate</div>
              <div class="w-full h-1 rounded-full bg-white/10 mt-2 overflow-hidden">
                <div class="h-full bg-gradient-to-r from-purple-500 to-indigo-400 w-full"></div>
              </div>
            </div>
          </div>
        </section>

        <!-- 2. Open Source Contributions Grid (30 PRs) -->
        <section class="backdrop-blur-2xl bg-neutral-950/70 border border-white/10 rounded-3xl p-6 sm:p-8 shadow-2xl space-y-5">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-4 border-b border-white/10">
            <div>
              <h2 class="text-xl sm:text-2xl font-bold text-white flex items-center gap-2.5">
                <span class="text-purple-400">⚡</span> OPEN-SOURCE CONTRIBUTIONS (30 MERGED PRS)
              </h2>
              <p class="text-xs text-neutral-400 font-mono">
                Production-grade contributions merged into core repositories across global tech leaders
              </p>
            </div>
            <div class="text-xs font-mono text-purple-400 bg-purple-500/10 px-3 py-1.5 rounded-full border border-purple-500/20 self-start sm:self-auto">
              Verified Production Commits
            </div>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 lg:grid-cols-6 gap-2.5">
            @foreach (var c in contributions)
            {
              <a
                href="@c.Url"
                target="_blank"
                rel="noopener noreferrer"
                class="group p-3 rounded-2xl bg-white/[0.02] hover:bg-white/[0.06] border border-white/5 hover:border-purple-500/40 transition-all flex flex-col justify-between space-y-2"
              >
                <div>
                  <div class="flex items-center justify-between">
                    <span class="text-xs font-bold text-white group-hover:text-purple-300 transition-colors">@c.Org</span>
                    <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">
                      MERGED
                    </span>
                  </div>
                  <div class="text-[11px] text-neutral-400 truncate font-mono mt-1" title="@c.Repo">
                    @c.Repo
                  </div>
                </div>
                <div class="flex items-center justify-between text-[10px] text-neutral-500 font-mono pt-1 border-t border-white/5">
                  <span class="text-neutral-400">@c.Pr</span>
                  <svg class="w-2.5 h-2.5 text-neutral-500 group-hover:text-purple-400 group-hover:translate-x-0.5 transition-all" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                </div>
              </a>
            }
          </div>
        </section>

        <!-- 3. Experience & Projects Split -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <!-- Work Experience -->
          <section class="backdrop-blur-2xl bg-neutral-950/70 border border-white/10 rounded-3xl p-6 sm:p-8 shadow-2xl space-y-5">
            <h2 class="text-xl font-bold text-white flex items-center gap-2">
              <span class="text-purple-400">💼</span> WORK EXPERIENCE
            </h2>

            <div class="space-y-6">
              @foreach (var exp in experiences)
              {
                <div class="border-l-2 border-purple-500/30 pl-4 space-y-2">
                  <div class="flex flex-wrap items-center justify-between gap-1">
                    <h3 class="text-base font-bold text-white">@exp.Role</h3>
                    <span class="text-xs font-mono text-neutral-400">@exp.Period</span>
                  </div>
                  <div class="text-xs font-semibold text-purple-300 font-mono">
                    @exp.Company · @exp.Location
                  </div>
                  <ul class="text-xs text-neutral-300 space-y-1.5 list-disc list-inside">
                    @foreach (var bullet in exp.Bullets)
                    {
                      <li class="leading-relaxed">@bullet</li>
                    }
                  </ul>
                </div>
              }
            </div>
          </section>

          <!-- Featured Projects -->
          <section class="backdrop-blur-2xl bg-neutral-950/70 border border-white/10 rounded-3xl p-6 sm:p-8 shadow-2xl space-y-5">
            <h2 class="text-xl font-bold text-white flex items-center gap-2">
              <span class="text-purple-400">🚀</span> FEATURED SYSTEMS &amp; HACKATHONS
            </h2>

            <div class="space-y-4">
              @foreach (var p in projects)
              {
                <div class="p-4 rounded-2xl bg-white/[0.02] border border-white/10 space-y-2.5">
                  <div class="flex items-start justify-between gap-2">
                    <h3 class="text-sm font-bold text-white">@p.Title</h3>
                    <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-purple-500/15 text-purple-300 border border-purple-500/30 shrink-0">
                      @p.Badge
                    </span>
                  </div>
                  <p class="text-xs text-neutral-300 leading-relaxed">@p.Description</p>
                  <div class="flex flex-wrap gap-1.5 pt-1">
                    @foreach (var tag in p.Tags)
                    {
                      <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-white/5 border border-white/5 text-neutral-300">
                        @tag
                      </span>
                    }
                  </div>
                </div>
              }
            </div>
          </section>
        </div>

        <!-- 4. Skills & Competencies -->
        <section class="backdrop-blur-2xl bg-neutral-950/70 border border-white/10 rounded-3xl p-6 sm:p-8 shadow-2xl space-y-5">
          <h2 class="text-xl font-bold text-white flex items-center gap-2">
            <span class="text-purple-400">🛠️</span> SKILLS &amp; TECHNICAL EXPERTISE
          </h2>

          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
            <div class="p-4 rounded-2xl bg-white/[0.02] border border-white/10 space-y-2">
              <h3 class="text-xs font-bold uppercase tracking-wider text-purple-400 font-mono">AI &amp; Data Science</h3>
              <div class="flex flex-wrap gap-1.5">
                @foreach (var s in skillsAI)
                {
                  <span class="text-xs px-2.5 py-1 rounded-lg bg-white/5 text-neutral-200 border border-white/5">@s</span>
                }
              </div>
            </div>

            <div class="p-4 rounded-2xl bg-white/[0.02] border border-white/10 space-y-2">
              <h3 class="text-xs font-bold uppercase tracking-wider text-indigo-400 font-mono">Languages</h3>
              <div class="flex flex-wrap gap-1.5">
                @foreach (var s in skillsLanguages)
                {
                  <span class="text-xs px-2.5 py-1 rounded-lg bg-white/5 text-neutral-200 border border-white/5">@s</span>
                }
              </div>
            </div>

            <div class="p-4 rounded-2xl bg-white/[0.02] border border-white/10 space-y-2">
              <h3 class="text-xs font-bold uppercase tracking-wider text-amber-400 font-mono">Full-Stack &amp; Frameworks</h3>
              <div class="flex flex-wrap gap-1.5">
                @foreach (var s in skillsDev)
                {
                  <span class="text-xs px-2.5 py-1 rounded-lg bg-white/5 text-neutral-200 border border-white/5">@s</span>
                }
              </div>
            </div>

            <div class="p-4 rounded-2xl bg-white/[0.02] border border-white/10 space-y-2">
              <h3 class="text-xs font-bold uppercase tracking-wider text-emerald-400 font-mono">Open-Source &amp; Git</h3>
              <div class="flex flex-wrap gap-1.5">
                @foreach (var s in skillsOpenSource)
                {
                  <span class="text-xs px-2.5 py-1 rounded-lg bg-white/5 text-neutral-200 border border-white/5">@s</span>
                }
              </div>
            </div>

            <div class="p-4 rounded-2xl bg-white/[0.02] border border-white/10 space-y-2">
              <h3 class="text-xs font-bold uppercase tracking-wider text-cyan-400 font-mono">Databases</h3>
              <div class="flex flex-wrap gap-1.5">
                @foreach (var s in skillsDatabases)
                {
                  <span class="text-xs px-2.5 py-1 rounded-lg bg-white/5 text-neutral-200 border border-white/5">@s</span>
                }
              </div>
            </div>

            <div class="p-4 rounded-2xl bg-white/[0.02] border border-white/10 space-y-2">
              <h3 class="text-xs font-bold uppercase tracking-wider text-rose-400 font-mono">DevOps &amp; Tools</h3>
              <div class="flex flex-wrap gap-1.5">
                @foreach (var s in skillsTools)
                {
                  <span class="text-xs px-2.5 py-1 rounded-lg bg-white/5 text-neutral-200 border border-white/5">@s</span>
                }
              </div>
            </div>
          </div>
        </section>

        <!-- 5. Achievements & Certifications -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <section class="backdrop-blur-2xl bg-neutral-950/70 border border-white/10 rounded-3xl p-6 shadow-2xl space-y-4">
            <h2 class="text-lg font-bold text-white flex items-center gap-2">
              <span class="text-amber-400">🏆</span> HONORS &amp; AWARDS
            </h2>
            <div class="space-y-2.5">
              @foreach (var a in achievements)
              {
                <div class="p-3 rounded-xl bg-white/[0.02] border border-white/5 flex items-center gap-3">
                  <span class="text-xl">@a.Icon</span>
                  <div>
                    <div class="text-xs font-semibold text-white">@a.Title</div>
                    @if (!string.IsNullOrEmpty(a.Subtitle))
                    {
                      <div class="text-[11px] text-neutral-400 font-mono">@a.Subtitle</div>
                    }
                  </div>
                </div>
              }
            </div>
          </section>

          <section class="backdrop-blur-2xl bg-neutral-950/70 border border-white/10 rounded-3xl p-6 shadow-2xl space-y-4">
            <h2 class="text-lg font-bold text-white flex items-center gap-2">
              <span class="text-blue-400">📜</span> CERTIFICATIONS
